# ---------------------------------------------------------------------------
# Client configuration (safe to ship in the bundle)
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard > Project Settings > Data API
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server-only secrets. These do NOT belong in this file at runtime - set them on
# Supabase with `npm run secrets:set` (see supabase/README.md). They are listed
# here purely as documentation of what the Edge Functions require.
# ---------------------------------------------------------------------------
# FINNHUB_API_KEY=          # https://finnhub.io/register        (60 req/min free)
# ALPACA_API_KEY_ID=        # https://alpaca.markets/            (free Basic plan)
# ALPACA_API_SECRET_KEY=
# GEMINI_API_KEY=           # https://aistudio.google.com/apikey (free tier)
# GEMINI_MODEL=             # optional override, defaults to gemini-2.5-flash
# TWELVE_DATA_API_KEY=      # optional fallback quote provider
# CRON_SECRET=              # any long random string; the same value goes in the
#                           # repository secrets so the alert cron can authenticate
